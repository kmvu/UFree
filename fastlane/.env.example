# Fastlane environment (names only)

Copy to `fastlane/.env` and fill values locally. Never commit `.env` or key material.

# App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=
# Optional local fallback instead of ASC_KEY_CONTENT:
ASC_KEY_PATH=

# Match (certificates)
MATCH_PASSWORD=
SSH_PRIVATE_KEY=

# Optional
APPLE_ID=
SLACK_WEBHOOK=

# Firebase CI deploy uses GitHub secret FIREBASE_TOKEN (not this file).
